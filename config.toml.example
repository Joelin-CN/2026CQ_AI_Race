# cqairace 运行配置模板。
# 复制为 config.toml 后按需修改；config.toml 不入库。
# 端口与字段语义见官方 docs/usage_guide.md（勿改任务系统接口）。

[cq_agent]
name = "cq_agent"
sleep_between_steps = 2.0        # 每步间隔秒数（官方默认 2.0）
log_dir = "logs"
tongsim_server_endpoint = "127.0.0.1:50060"   # TongSim 仿真代理，保持默认

[grpc]
endpoint = "127.0.0.1:50051"     # 任务系统（赛题系统），保持默认

[routing]
# 任务类型 → VLM 配置类名（多模型按任务混合路由，见架构文档决策 D2）。
# 类名须在官方 vlm_config.__ALL__ 中，可用 `uv run arenaagent --get_vlm_model` 列出；
# 所需 API key 走环境变量（见官方 docs/vlm_config_table.md）。
default = "VLMGPT5Config"        # 兜底默认模型（官方默认）
# 按任务覆盖（示例，落地 P2 阶段后生效）：
# npc      = "VLMGLMConfig"      # 对话任务用强语言模型
# jigsaw   = "VLMQwen3VLPlus"    # 视觉任务用强视觉模型
# tidyroom = "VLMQwen3VLPlus"
